# Only the build files are tracked; everything else here stays local.
/*
!/.gitignore
!/README.md
!/LICENSE
!/build.sh
!/build-all.sh
!/flash-sd.sh
!/userpatches/
!/patches/
/patches/v4l-utils/
!/scripts/
/scripts/*
!/scripts/build-media-debs.sh
!/scripts/build-armbian-debs.sh
__pycache__/
*.log
/userpatches/config-example.conf
