       - pkexec
       - libfido2-1
+  stonking: # Ubuntu 26.10: same as resolute
+    # Ubuntu 26.04 LTS — same as questing.
+    architectures: [arm64, amd64, armhf, riscv64]
+    packages:
+      - polkitd
+      - pkexec
+      - libfido2-1
diff --git a/tools/modules/desktops/yaml/gnome.yaml b/tools/modules/desktops/yaml/gnome.yaml
index d54b46f..3fc7e2a 100644
--- a/tools/modules/desktops/yaml/gnome.yaml
+++ b/tools/modules/desktops/yaml/gnome.yaml
@@ -176,3 +176,20 @@ releases:
       - pavumeter
     packages_uninstall:
       - ubuntu-session
+  stonking: # Ubuntu 26.10: same as resolute
