+      - polkitd
+      - pkexec
+      - libfido2-1
+      # GNOME Software stack (see noble block above for rationale).
+      - packagekit
+      - gnome-software-plugin-flatpak
+      - gnome-software-plugin-fwupd
+      - appstream
+    packages_remove:
+      # pavumeter remains absent from the Ubuntu archive (dropped in plucky).
+      - pavumeter
+    packages_uninstall:
+      - ubuntu-session
