# Orange Pi Zero2 test link: USB Realtek adapter wired directly to the board.
# Host is 10.56.0.1; the board gets 10.56.0.100-149 by DHCP and NAT to the LAN.
# Install: sudo cp harness/06-opiz2-enx68da73af6279.network /etc/systemd/network/ && sudo networkctl reload
[Match]
MACAddress=68:da:73:af:62:79

[Link]
# Must equal the board's MTU (1500, the LAN standard): a bigger host MTU makes the host send frames the board must
# drop (the 11-03 "lost 8000-byte pings"). Jumbo tests raise both ends (board max_mtu 2018) for the test only.
MTUBytes=1500

[Network]
Address=10.56.0.1/24
DHCPServer=yes
IPMasquerade=ipv4
ConfigureWithoutCarrier=yes

[DHCPServer]
PoolOffset=100
PoolSize=50
EmitDNS=yes
DNS=192.168.107.1
# U-Boot (netboot/PXE) never renews and sends no client identifier, so its lease is keyed by
# 01:<MAC>. systemd's server refuses the static lease below to any *other* client identity
# while that lease is bound (dhcp_server_process_discover(): -EADDRINUSE), which locked the
# board's Linux (RFC 4361 DUID identity) out for the 1 h default. Keep firmware leases short;
# the real fix is the board using ClientIdentifier=mac (netplan dhcp-identifier: mac) so
# U-Boot, the kernel's ip=dhcp and networkd share one identity, see harness/netboot/README.
DefaultLeaseTimeSec=5min

# Pin the Zero2 (U-Boot derives this MAC from the SoC ID, stable across reflashes) to a fixed address.
[DHCPServerStaticLease]
MACAddress=02:00:8a:27:57:7d
Address=10.56.0.107
