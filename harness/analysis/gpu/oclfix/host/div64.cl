__kernel void div_l16(__global long16 *srcA, __global long16 *srcB, __global long16 *dst)
{ int tid = get_global_id(0); dst[tid] = srcA[tid] / srcB[tid]; }
__kernel void div_l1(__global long *srcA, __global long *srcB, __global long *dst)
{ int tid = get_global_id(0); dst[tid] = srcA[tid] / srcB[tid]; }
__kernel void div_l2(__global long2 *srcA, __global long2 *srcB, __global long2 *dst)
{ int tid = get_global_id(0); dst[tid] = srcA[tid] / srcB[tid]; }
__kernel void div_ul8(__global ulong8 *srcA, __global ulong8 *srcB, __global ulong8 *dst)
{ int tid = get_global_id(0); dst[tid] = srcA[tid] / srcB[tid]; }
__kernel void mod_l16(__global long16 *srcA, __global long16 *srcB, __global long16 *dst)
{ int tid = get_global_id(0); dst[tid] = srcA[tid] % srcB[tid]; }
