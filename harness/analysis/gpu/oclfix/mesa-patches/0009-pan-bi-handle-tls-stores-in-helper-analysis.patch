From c5b41dcf69ce3c5e11ffb9e1140904e3fa79a0b7 Mon Sep 17 00:00:00 2001
From: Erik Faye-Lund <erik.faye-lund@arm.com>
Date: Fri, 16 Oct 2026 11:15:22 +0200
Subject: [PATCH 09/17] pan/bi: handle tls-stores in helper analysis

A value that was stored in a TLS variable might require helper
invocations after being loaded back. We don't currently track this
through memory, meaning we'd incorrectly ignore helpers in this
case, leading to incorrect behavior.

Fix this by always considering TLS-stores as requiring helpers. This
technically makes us a little bit conservative. While we could have
offset this by bumping the max_lower_array_len parameter we pass to
nir_lower_indirect_derefs_to_if_else_trees instead, there would
always be a point where we started bumping into this, unless we went
all the way up to the max TLS size, which seems overly aggressive.

This matches how the common nir_opt_load_skip_helpers works, which
is what Kraid uses.

Fixes the following VK-CTS tests when running without Kraid:
- dEQP-VK.glsl.helper_invocation.load_after_store*

Fixes: 3fef3b6afcf7 ("pan/bi: Analyze helper invocations")
Reviewed-by: Christian Gmeiner <cgmeiner@igalia.com>
Reviewed-by: Christoph Pillmayer <christoph.pillmayer@arm.com>
(cherry picked from commit 45ea3ed8ce649d6b72d1843307a29d9cc3b7704e)

Part-of: <https://gitlab.freedesktop.org/mesa/mesa/-/merge_requests/45704>
(cherry picked from commit 800328435420685e654dcf85650f40844dd630e2)
---
 src/panfrost/compiler/bifrost/bi_helper_invocations.c | 10 +++++++++-
 1 file changed, 9 insertions(+), 1 deletion(-)

diff --git a/src/panfrost/compiler/bifrost/bi_helper_invocations.c b/src/panfrost/compiler/bifrost/bi_helper_invocations.c
index e7b32aecffe..fc310f84f3f 100644
--- a/src/panfrost/compiler/bifrost/bi_helper_invocations.c
+++ b/src/panfrost/compiler/bifrost/bi_helper_invocations.c
@@ -1,5 +1,6 @@
 /*
  * Copyright (C) 2019-2021 Collabora, Ltd.
+ * Copyright (C) 2026 Arm Ltd.
  * SPDX-License-Identifier: MIT
  */
 
@@ -237,6 +238,13 @@ bi_helper_block_update(BITSET_WORD *deps, bi_block *block)
    return progress;
 }
 
+static bool
+bi_is_tls_store(const bi_instr *I)
+{
+   return bi_get_opcode_props(I)->message == BIFROST_MESSAGE_STORE &&
+          I->seg == BI_SEG_TL;
+}
+
 void
 bi_analyze_helper_requirements(bi_context *ctx)
 {
@@ -246,7 +254,7 @@ bi_analyze_helper_requirements(bi_context *ctx)
     * derivatives and the sources of conditional branch instructions */
 
    bi_foreach_instr_global(ctx, I) {
-      if (bi_instr_uses_helpers(I)) {
+      if (bi_instr_uses_helpers(I) || bi_is_tls_store(I)) {
          bi_foreach_ssa_src(I, s)
             BITSET_SET(deps, I->src[s].value);
       } else {
