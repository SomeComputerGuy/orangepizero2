From c38610a6927a5385d45bf7969b137a0b67c17c3d Mon Sep 17 00:00:00 2001
From: =?UTF-8?q?Daniel=20Sch=C3=BCrmann?= <daniel@schuermann.dev>
Date: Tue, 20 Oct 2026 16:44:07 +0200
Subject: [PATCH 11/17] nir/lower_continue_constructs: preserve SSA dominance
 across nested exits

Recognize branch legs that unconditionally exit through nested conditionals.
Move following code into the surviving branch leg before lowering its jumps,
so direct SSA uses retain dominance without an SSA repair pass.

Fixes: 31af989270f ("nir/lower_continue_constructs: Simplify loops before lowering continue constructs")
Generated-by: LLM
(cherry picked from commit 69e0bf9e517784abef00ce1fe684400fbe2ad996)

Part-of: <https://gitlab.freedesktop.org/mesa/mesa/-/merge_requests/45704>
(cherry picked from commit 974c12348256f0de2dd0b1136d8166bb349baf9d)
---
 .../nir/nir_lower_continue_constructs.c       |  26 ++++-
 src/compiler/nir/tests/control_flow_tests.cpp | 105 ++++++++++++++++++
 2 files changed, 129 insertions(+), 2 deletions(-)

diff --git a/src/compiler/nir/nir_lower_continue_constructs.c b/src/compiler/nir/nir_lower_continue_constructs.c
index c5f1155a7c0..ff5276630b6 100644
--- a/src/compiler/nir/nir_lower_continue_constructs.c
+++ b/src/compiler/nir/nir_lower_continue_constructs.c
@@ -86,6 +86,24 @@ lower_jump(nir_block *block, struct loop_simplify_state *state)
    return true;
 }
 
+static bool
+cf_list_ends_in_jump(struct exec_list *cf_list)
+{
+   foreach_list_typed(nir_cf_node, node, node, cf_list) {
+      if (node->type == nir_cf_node_block) {
+         if (nir_block_ends_in_jump(nir_cf_node_as_block(node)))
+            return true;
+      } else if (node->type == nir_cf_node_if) {
+         nir_if *nif = nir_cf_node_as_if(node);
+         if (cf_list_ends_in_jump(&nif->then_list) &&
+             cf_list_ends_in_jump(&nif->else_list))
+            return true;
+      }
+   }
+
+   return false;
+}
+
 static bool
 lower_jumps_in_if(nir_if *nif, struct loop_simplify_state *state)
 {
@@ -98,8 +116,12 @@ lower_jumps_in_if(nir_if *nif, struct loop_simplify_state *state)
 
    nir_block *then_block = nir_if_last_then_block(nif);
    nir_block *else_block = nir_if_last_else_block(nif);
-   bool then_jumps = nir_block_ends_in_jump(then_block);
-   bool else_jumps = nir_block_ends_in_jump(else_block);
+   /* A branch leg can also exit through jumps in both sides of a nested if.
+    * Detect this before lowering so following code is moved into the
+    * surviving branch leg before any of its jumps are removed.
+    */
+   bool then_jumps = cf_list_ends_in_jump(&nif->then_list);
+   bool else_jumps = cf_list_ends_in_jump(&nif->else_list);
 
    bool progress = false;
    progress |= lower_jump(then_block, state);
diff --git a/src/compiler/nir/tests/control_flow_tests.cpp b/src/compiler/nir/tests/control_flow_tests.cpp
index 3df2204ef1b..4346c955f73 100644
--- a/src/compiler/nir/tests/control_flow_tests.cpp
+++ b/src/compiler/nir/tests/control_flow_tests.cpp
@@ -277,3 +277,108 @@ TEST_F(nir_lower_continue_constructs_test, nested_continue_unreachable_phi_prede
       }
    )"));
 }
+
+TEST_F(nir_lower_continue_constructs_test, nested_continue_unreachable_value)
+{
+   nir_loop *loop = nir_push_loop(b);
+   nir_loop_add_continue_construct(loop);
+   nir_push_if(b, nir_unit_test_uniform_input(b, 1, 1));
+   nir_push_if(b, nir_unit_test_uniform_input(b, 1, 1, 1));
+   nir_def *value = nir_unit_test_uniform_input(b, 1, 32, 2);
+   nir_push_else(b, NULL);
+   nir_push_if(b, nir_unit_test_uniform_input(b, 1, 1, 3));
+   nir_jump(b, nir_jump_continue);
+   nir_push_else(b, NULL);
+   nir_jump(b, nir_jump_break);
+   nir_pop_if(b, NULL);
+   nir_pop_if(b, NULL);
+   nir_use(b, value);
+   nir_push_else(b, NULL);
+   nir_def *other = nir_unit_test_uniform_input(b, 1, 32, 4);
+   nir_pop_if(b, NULL);
+   nir_use(b, nir_if_phi(b, value, other));
+   nir_break_if(b, nir_unit_test_uniform_input(b, 1, 1, 5));
+   nir_pop_loop(b, NULL);
+
+   nir_validate_shader(b->shader, "before lowering continue constructs");
+   ASSERT_TRUE(nir_lower_continue_constructs(b->shader));
+   nir_validate_shader(b->shader, "after lowering continue constructs");
+
+   check_nir_string(NIR_REFERENCE_SHADER(R"(
+      shader: MESA_SHADER_COMPUTE
+      name: nir_lower_continue_constructs_test
+      workgroup_size: 1, 1, 1
+      max_subgroup_size: 128
+      min_subgroup_size: 1
+      decl_function main () (entrypoint)
+
+      impl main {
+          block b0:   // preds:
+          32     %0 = undefined
+                      // succs: b1
+          loop {
+              block b1:   // preds: b0 b16
+              32     %1 = phi b0: %0, b16: %12
+              1      %2 = load_const (false)
+              1      %3 = @unit_test_uniform_input (base=0)
+                          // succs: b2 b9
+              if %3 {
+                  block b2:   // preds: b1
+                  1      %4 = @unit_test_uniform_input (base=1)
+                              // succs: b3 b4
+                  if %4 {
+                      block b3:   // preds: b2
+                      32     %5 = @unit_test_uniform_input (base=2)
+                                  @use (%5)
+                                  // succs: b8
+                  } else {
+                      block b4:   // preds: b2
+                      1      %6 = @unit_test_uniform_input (base=3)
+                                  // succs: b5 b6
+                      if %6 {
+                          block b5:   // preds: b4
+                          1      %7 = load_const (true)
+                                      // succs: b7
+                      } else {
+                          block b6:// preds: b4
+                          break
+                          // succs: b17
+                      }
+                      block b7:  // preds: b5, succs: b8
+                  }
+                  block b8:   // preds: b3 b7
+                  1      %8 = phi b3: %2 (false), b7: %7 (true)
+                  32     %9 = phi b3: %5, b7: %1
+                              // succs: b10
+              } else {
+                  block b9:   // preds: b1
+                  32    %10 = @unit_test_uniform_input (base=4)
+                              // succs: b10
+              }
+              block b10:  // preds: b8 b9
+              1     %11 = phi b8: %8, b9: %2 (false)
+              32    %12 = phi b8: %9, b9: %10
+                          // succs: b11 b12
+              if %11 {
+                  block b11:  // preds: b10, succs: b16
+              } else {
+                  block b12:  // preds: b10
+                              @use (%12)
+                  1     %13 = @unit_test_uniform_input (base=5)
+                              // succs: b13 b14
+                  if %13 {
+                      block b13:// preds: b12
+                      break
+                      // succs: b17
+                  } else {
+                      block b14:  // preds: b12, succs: b15
+                  }
+                  block b15:  // preds: b14, succs: b16
+              }
+              block b16:  // preds: b11 b15, succs: b1
+          }
+          block b17:  // preds: b6 b13, succs: b18
+          block b18:
+      }
+   )"));
+}
