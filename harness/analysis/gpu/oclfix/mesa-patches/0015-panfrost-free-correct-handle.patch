From 5f763d6d6f2a38c79cd786076d92f1aeb87b1d7c Mon Sep 17 00:00:00 2001
From: Erik Faye-Lund <erik.faye-lund@arm.com>
Date: Tue, 13 Oct 2026 18:05:48 +0200
Subject: [PATCH 15/17] panfrost: free correct handle

If drmSyncobjCreate fails, bo->base.handle has not been written to yet.
That field is written by pan_kmod_bo_init, which is called later on. So
we need to destroy through the handle stored in req instead, otherwise
we'll leak memory here.

Fixes: 97f6a62f7ef8 ("pan/kmod: Add a backend for panthor")
Reviewed-by: Boris Brezillon <boris.brezillon@collabora.com>
(cherry picked from commit fa9a434f7b15aaf0760df5982b592f4c622fc07c)

Part-of: <https://gitlab.freedesktop.org/mesa/mesa/-/merge_requests/45704>
(cherry picked from commit 67144c1f2a8b836c0ecfde39a92e95878fd1113a)
---
 src/panfrost/lib/kmod/panthor_kmod.c | 2 +-
 1 file changed, 1 insertion(+), 1 deletion(-)

diff --git a/src/panfrost/lib/kmod/panthor_kmod.c b/src/panfrost/lib/kmod/panthor_kmod.c
index 8c73e6a3570..2d1f28ebd78 100644
--- a/src/panfrost/lib/kmod/panthor_kmod.c
+++ b/src/panfrost/lib/kmod/panthor_kmod.c
@@ -443,7 +443,7 @@ panthor_kmod_bo_alloc(struct pan_kmod_dev *dev,
    return &bo->base;
 
 err_destroy_bo:
-   drmCloseBufferHandle(dev->fd, bo->base.handle);
+   drmCloseBufferHandle(dev->fd, req.handle);
 err_free_bo:
    pan_kmod_dev_free(dev, bo);
    return NULL;
