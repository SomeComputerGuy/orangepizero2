-# GStreamer JPEG: autoplugging (playbin, decodebin, gst-play) must not pick v4l2jpegdec. It ranks
-# PRIMARY+1, above the software jpegdec, but cannot drive cedrus (stateless; v4l2jpegdec expects the
-# stateful protocol): on the board it outputs nothing for colour JPEGs and hangs on greyscale
-# (harness/research/impl-di-jpeg-avs.md 7.6). MARGINAL keeps it installed and usable in explicit
-# pipelines. Login shells read /etc/environment; system and user services get the same value
-# through systemd's DefaultEnvironment.
+# GStreamer JPEG: cedrus decodes JPEG through v4l2sljpegdec (v4l2codecs, our gst-plugins-bad rebuild below, rank
+# PRIMARY+1). Its sink caps take only what the hardware decodes, so decodebin/playbin give greyscale, progressive,
+# RGB/CMYK and other sampling layouts to the software jpegdec. v4l2jpegdec (gst-plugins-good, also PRIMARY+1) cannot
+# drive cedrus (stateless; it expects the stateful protocol): on the board it outputs nothing for colour JPEGs and
+# hangs on greyscale (harness/research/impl-di-jpeg-avs.md 7.6), and at equal rank it sorts before v4l2sljpegdec. So it
+# stays MARGINAL: installed and usable in explicit pipelines, never autoplugged. Login shells read /etc/environment;
+# system and user services get the same value through systemd's DefaultEnvironment.
 function image_specific_armbian_env_ready__opiz2_gst_jpeg_rank() {
 	local v='GST_PLUGIN_FEATURE_RANK=v4l2jpegdec:MARGINAL' d
 	grep -q '^GST_PLUGIN_FEATURE_RANK=' "${SDCARD}/etc/environment" 2>/dev/null ||
@@ -121,6 +122,43 @@ function image_specific_armbian_env_ready__opiz2_gst_jpeg_rank() {
 	done
 }
 
+# GStreamer in every variant (gstreamer1.0-plugins-bad is in all of them): our gst-plugins-bad rebuild from
+# out/debs-media (scripts/build-media-debs.sh gst-plugins-bad1.0; build.sh runs it): v4l2sljpegdec (cedrus JPEG), the
+# jpegparse sampling-factors caps it keys on, and the orangepi5 v4l2codecs/kmssink fixes (patches/gstreamer). The
+# desktop variant gets it with the rest of the media repository (post_repo_customize_image__opiz2_desktop_media);
+# minimal/server get a repository of this source's packages only, pinned the same way.
+function post_repo_customize_image__opiz2_gst_media() {
+	[[ "${BUILD_DESKTOP}" == "yes" ]] && return 0
+	local src="${OPIZ2_MEDIA_DEBS:-$(realpath "${USERPATCHES_PATH}/..")/out/debs-media}" dst="${SDCARD}/opt/opiz2-media" d s p
+	compgen -G "${src}/gstreamer1.0-plugins-bad_*+opiz2*_arm64.deb" > /dev/null ||
+		exit_with_error "missing the gst-plugins-bad1.0 rebuild in ${src}" "run scripts/build-media-debs.sh gst-plugins-bad1.0 (build.sh does it)"
+	mkdir -p "${dst}"
+	for d in "${src}"/*+opiz2*.deb; do
+		s=$(dpkg-deb -f "${d}" Source); s=${s%% *}
+		[[ "${s}" == gst-plugins-bad1.0 ]] && cp -p "${d}" "${dst}/"
+	done
+	(cd "${dst}" && dpkg-scanpackages --multiversion . /dev/null > Packages 2> /dev/null)
+	echo "deb [trusted=yes] file:/opt/opiz2-media ./" > "${SDCARD}/etc/apt/sources.list.d/opiz2-media.list"
+	cat > "${SDCARD}/etc/apt/preferences.d/opiz2-media.pref" <<- 'PREF'
+		# Orange Pi Zero2: our gst-plugins-bad rebuild (v4l2sljpegdec for cedrus JPEG; /opt/opiz2-media, built by
+		# scripts/build-media-debs.sh). Keep it over the archive's version.
+		# origin "" = local (file:) repositories; apt 3.3 rejects "Pin: version" globs ("Did not understand pin type").
+		Package: *
+		Pin: origin ""
+		Pin-Priority: 1001
+	PREF
+	chroot_sdcard_apt_get_update
+	local -a ours=() installed
+	mapfile -t installed < <(LC_ALL=C chroot "${SDCARD}" dpkg-query -W -f '${Package}\n')
+	for p in $(sed -n 's/^Package: //p' "${dst}/Packages" | sort -u); do
+		[[ " ${installed[*]} " == *" ${p} "* ]] && ours+=("${p}")
+	done
+	chroot_sdcard_apt_get_install --allow-downgrades "${ours[@]}"
+	p=$(LC_ALL=C chroot "${SDCARD}" dpkg-query -W -f '${Version}' gstreamer1.0-plugins-bad)
+	[[ "${p}" == *+opiz2* ]] || exit_with_error "not our gstreamer1.0-plugins-bad after install" "${p}"
+	display_alert "GStreamer" "gst-plugins-bad ${p} (${#ours[@]} packages from /opt/opiz2-media)" "info"
+}
