+        if (s->pict_type == AV_PICTURE_TYPE_B && s->full_pel[1])
+            controls->picture.flags |= V4L2_MPEG2_PIC_FLAG_FULL_PEL_BACKWARD;
+    }
+
     switch (s->pict_type) {
     case AV_PICTURE_TYPE_B:
