From d66157f2faf931da762e78cd6758bc2583a53c51 Mon Sep 17 00:00:00 2001
From: Arun Iyengar <aiyengar1990@gmail.com>
Date: Sun, 1 Nov 2026 22:04:47 +0000
Subject: [PATCH 3/3] unisocwcn: sdiohal_ctl: only declare pub_gpio_desc when
 parsing DT

Signed-off-by: Arun Iyengar <aiyengar1990@gmail.com>
---
 unisocwcn/sdio/sdiohal_ctl.c | 5 +++--
 1 file changed, 3 insertions(+), 2 deletions(-)

diff --git a/unisocwcn/sdio/sdiohal_ctl.c b/unisocwcn/sdio/sdiohal_ctl.c
index 0e03415..0b2e95b 100644
--- a/unisocwcn/sdio/sdiohal_ctl.c
+++ b/unisocwcn/sdio/sdiohal_ctl.c
@@ -753,10 +753,11 @@ static int sdiohal_test_int_init(unsigned char func_tag)
 {
 #ifdef CONFIG_WCN_PARSE_DTS
 	struct device_node *np;
-#endif
 #if LINUX_VERSION_CODE >= KERNEL_VERSION(7, 1, 0)
 	struct gpio_desc *pub_gpio_desc = NULL;
-#else
+#endif
+#endif
+#if LINUX_VERSION_CODE < KERNEL_VERSION(7, 1, 0)
 	unsigned int pub_gpio_num = 0;
 #endif
 	unsigned char reg_int_en = 0;
-- 
