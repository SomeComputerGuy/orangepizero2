+static u32 dbg_cnt_s[4];
+
+void cedrus_dbg_cnt_start(struct cedrus_dev *dev)
+{
+	if (!dbg_cnt)
+		return;
+	cedrus_write(dev, 0x20, BIT(31));
+	cedrus_write(dev, 0x24, BIT(31));
+	dbg_cnt_s[0] = cedrus_read(dev, 0x20);
+	dbg_cnt_s[1] = cedrus_read(dev, 0x24);
+	dbg_cnt_s[2] = cedrus_read(dev, 0x10);
+	dbg_cnt_s[3] = cedrus_read(dev, 0x14);
+}
+
+void cedrus_dbg_cnt_stop(struct cedrus_dev *dev)
+{
+	if (!dbg_cnt)
+		return;
+	dbg_rd += (cedrus_read(dev, 0x20) - dbg_cnt_s[0]) & 0x7fffffff;
+	dbg_wr += (cedrus_read(dev, 0x24) - dbg_cnt_s[1]) & 0x7fffffff;
+	dbg_mmc += (cedrus_read(dev, 0x10) - dbg_cnt_s[2]) & 0xffffff;
+	dbg_cache += (cedrus_read(dev, 0x14) - dbg_cnt_s[3]) & 0xffffff;
+	dbg_jobs++;
+}
