#version 450
#extension GL_KHR_shader_subgroup_basic: enable
#extension GL_KHR_shader_subgroup_ballot: enable
layout (local_size_x_id = 0, local_size_y_id = 1, local_size_z_id = 2) in;
layout (set = 0, binding = 0, std430) buffer Buffer1 { uint result[]; };
uint off() { uvec3 g = gl_NumWorkGroups * gl_WorkGroupSize; return g.x * ((g.y * gl_GlobalInvocationID.z) + gl_GlobalInvocationID.y) + gl_GlobalInvocationID.x; }

shared uvec4 h[gl_WorkGroupSize.x * gl_WorkGroupSize.y * gl_WorkGroupSize.z];
void main() { uint g = gl_LocalInvocationIndex / 4u; if ((gl_LocalInvocationIndex & 3u) == 0u) h[g] = uvec4(0); subgroupMemoryBarrierShared(); atomicOr(h[g].x, 1u << (gl_LocalInvocationIndex & 3u)); subgroupMemoryBarrierShared(); result[off()] = bitCount(h[g].x); }
