#version 450
#extension GL_ARM_shader_core_builtins: enable
layout (local_size_x_id = 0, local_size_y_id = 1, local_size_z_id = 2) in;
layout (set = 0, binding = 0, std430) buffer Buffer1 { uint result[]; };
/* Raw ARM core builtins over the whole dispatch (job 68 rerun, after d9 saw ids above the old max):
 * [0] max CoreIDARM  [1] max WarpIDARM  [2] invocations with WarpIDARM > WarpMaxIDARM
 * [3] invocations with CoreIDARM >= CoreCountARM  [4] OR of WarpIDARM  [5] OR of CoreIDARM
 * [6] WarpMaxIDARM  [7] CoreCountARM  [8] invocation count */
void main() {
  uint c = gl_CoreIDARM, w = gl_WarpIDARM;
  atomicMax(result[0], c); atomicMax(result[1], w);
  if (w > gl_WarpMaxIDARM) atomicAdd(result[2], 1u);
  if (c >= gl_CoreCountARM) atomicAdd(result[3], 1u);
  atomicOr(result[4], w); atomicOr(result[5], c);
  result[6] = gl_WarpMaxIDARM; result[7] = gl_CoreCountARM;
  atomicAdd(result[8], 1u);
}
