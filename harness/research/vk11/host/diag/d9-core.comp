#version 450
#extension GL_ARM_shader_core_builtins: enable
layout (local_size_x_id = 0, local_size_y_id = 1, local_size_z_id = 2) in;
layout (set = 0, binding = 0, std430) buffer Buffer1 { uint result[]; };
uint off() { uvec3 g = gl_NumWorkGroups * gl_WorkGroupSize; return g.x * ((g.y * gl_GlobalInvocationID.z) + gl_GlobalInvocationID.y) + gl_GlobalInvocationID.x; }
/* byte 0 core id, 1 core count, 2 warp id, 3 warp max id; 0xffffffff if id > max or core id >= count */
void main() {
  uint c = gl_CoreIDARM, n = gl_CoreCountARM, w = gl_WarpIDARM, m = gl_WarpMaxIDARM;
  bool ok = c < n && c <= gl_CoreMaxIDARM && w <= m && n < 256u && m < 256u;
  result[off()] = ok ? (c | (n << 8) | (w << 16) | (m << 24)) : 0xffffffffu;
}
