From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: Arun Iyengar <aiyengar1990@gmail.com>
Date: Sun, 15 Nov 2026 17:55:58 +0000
Subject: [PATCH] kmssink: Set a mode that holds the video when no mode has its
 size

With force-modesetting the caps only offer the connector's mode sizes,
and the mode must have the video size. A stateless decoder queries
downstream with its coded size (1920x1088 for 1080p), and films are
often cropped (3840x1714), so these streams fail to negotiate.

When the video goes to an overlay plane, offer any size, and if no mode
has the video size, set the smallest mode that holds it, preferring a
refresh rate that is a multiple of the frame rate; the video is scaled
into it as without modesetting. The black primary buffer gets the mode
size. Video on the primary plane keeps the current behaviour.

Assisted-by: LLM
Signed-off-by: Arun Iyengar <aiyengar1990@gmail.com>
---
 sys/kms/gstkmssink.c | 65 ++++++++++++++++++++++++++++++++++++--------
 1 file changed, 53 insertions(+), 12 deletions(-)

diff --git a/sys/kms/gstkmssink.c b/sys/kms/gstkmssink.c
index a087cca..623c885 100644
--- a/sys/kms/gstkmssink.c
+++ b/sys/kms/gstkmssink.c
@@ -827,6 +827,8 @@ find_mode_for_video (GstKMSSink * self, drmModeConnector * conn,
 {
   drmModeModeInfo *first = NULL;
   gdouble fps = 0;
+  gint64 best_area = 0;
+  gboolean best_rate_ok = FALSE;
   gint i;
 
   if (GST_VIDEO_INFO_FPS_N (vinfo) > 0 && GST_VIDEO_INFO_FPS_D (vinfo) > 0)
@@ -856,6 +858,40 @@ find_mode_for_video (GstKMSSink * self, drmModeConnector * conn,
     }
   }
 
+  if (first || self->plane_is_primary)
+    return first;
+
+  /* An overlay plane can show the video scaled in the smallest mode that
+   * holds it, preferably at a multiple of its frame rate */
+  for (i = 0; i < conn->count_modes; i++) {
+    drmModeModeInfo *mode = &conn->modes[i];
+    gdouble refresh, multiple;
+    gint64 area = (gint64) mode->hdisplay * mode->vdisplay;
+    gboolean rate_ok;
+
+    if (mode->hdisplay < GST_VIDEO_INFO_WIDTH (vinfo) ||
+        mode->vdisplay < GST_VIDEO_INFO_HEIGHT (vinfo) ||
+        (mode->flags & DRM_MODE_FLAG_INTERLACE))
+      continue;
+
+    refresh = mode_refresh_rate (mode);
+    multiple = fps > 0 ? round (refresh / fps) : 0;
+    rate_ok = multiple >= 1 &&
+        fabs (refresh - multiple * fps) < refresh * 0.0005;
+
+    if (!first || area < best_area || (area == best_area && rate_ok &&
+            !best_rate_ok)) {
+      first = mode;
+      best_area = area;
+      best_rate_ok = rate_ok;
+    }
+  }
+
+  if (first)
+    GST_DEBUG_OBJECT (self, "no %dx%d mode, showing the video in %s@%.3f",
+        GST_VIDEO_INFO_WIDTH (vinfo), GST_VIDEO_INFO_HEIGHT (vinfo),
+        first->name, mode_refresh_rate (first));
+
   return first;
 }
 
@@ -944,27 +980,27 @@ configure_mode_setting (GstKMSSink * self, GstVideoInfo * vinfo)
 
   ensure_kms_allocator (self);
 
+  conn = drmModeGetConnector (self->fd, self->conn_id);
+  if (!conn)
+    goto connector_failed;
+
+  mode = find_mode_for_video (self, conn, vinfo);
+  if (!mode)
+    goto mode_failed;
+
   if (self->plane_is_primary) {
     kmsmem = (GstKMSMemory *) gst_kms_allocator_bo_alloc (self->allocator,
         vinfo);
   } else {
     /* The video goes to another plane, so set the mode with a black buffer
      * on the primary plane */
-    kmsmem = alloc_black_primary_buffer (self, GST_VIDEO_INFO_WIDTH (vinfo),
-        GST_VIDEO_INFO_HEIGHT (vinfo));
+    kmsmem = alloc_black_primary_buffer (self, mode->hdisplay,
+        mode->vdisplay);
   }
   if (!kmsmem)
     goto bo_failed;
   fb_id = kmsmem->fb_id;
 
-  conn = drmModeGetConnector (self->fd, self->conn_id);
-  if (!conn)
-    goto connector_failed;
-
-  mode = find_mode_for_video (self, conn, vinfo);
-  if (!mode)
-    goto mode_failed;
-
   GST_INFO_OBJECT (self, "setting mode %s@%.3f", mode->name,
       mode_refresh_rate (mode));
 
@@ -1262,16 +1298,21 @@ get_plane_caps (GstKMSSink * self, drmModeConnector * conn,
         "the fourcc and modifier list, no DMA mode support.");
   }
 
+  /* Video on an overlay plane fits any mode that holds it
+   * (find_mode_for_video()) */
   if (conn && self->modesetting_enabled)
     count_modes = conn->count_modes;
   else
-    count_modes = 1;
+    count_modes = 0;
+  if (count_modes == 0 || get_plane_type (self->fd,
+          plane->plane_id) == DRM_PLANE_TYPE_OVERLAY)
+    count_modes++;
 
   for (i = 0; i < count_modes; i++) {
     tmp_caps = gst_caps_new_empty ();
 
     mode = NULL;
-    if (conn && self->modesetting_enabled)
+    if (conn && self->modesetting_enabled && i < conn->count_modes)
       mode = &conn->modes[i];
 
     for (j = 0; j < plane->count_formats; j++) {
-- 
