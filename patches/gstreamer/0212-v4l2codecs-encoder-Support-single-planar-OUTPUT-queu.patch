From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: Arun Iyengar <aiyengar1990@gmail.com>
Date: Fri, 13 Nov 2026 04:19:13 +0000
Subject: [PATCH 2/2] v4l2codecs: encoder: Support single-planar OUTPUT queues

The helper rejected every raw format of a driver with single-planar
queues (V4L2_CAP_VIDEO_M2M), such as the H.264 encoder of cedrus:
"The driver rejected video/x-raw, format=I420". Set the OUTPUT format
and queue the pictures through struct v4l2_pix_format and m.fd on such
drivers, as one plane, and add YV12 (YVU420), which cedrus also takes.

Assisted-by: LLM
Signed-off-by: Arun Iyengar <aiyengar1990@gmail.com>
---
 sys/v4l2codecs/gstv4l2encoder.c | 66 ++++++++++++++++++++++++++++-----
 1 file changed, 57 insertions(+), 9 deletions(-)

diff --git a/sys/v4l2codecs/gstv4l2encoder.c b/sys/v4l2codecs/gstv4l2encoder.c
index edede6c..5777838 100644
--- a/sys/v4l2codecs/gstv4l2encoder.c
+++ b/sys/v4l2codecs/gstv4l2encoder.c
@@ -123,6 +123,8 @@ static const struct
   {GST_VIDEO_FORMAT_NV21, V4L2_PIX_FMT_NV21M},
   {GST_VIDEO_FORMAT_I420, V4L2_PIX_FMT_YUV420},
   {GST_VIDEO_FORMAT_I420, V4L2_PIX_FMT_YUV420M},
+  {GST_VIDEO_FORMAT_YV12, V4L2_PIX_FMT_YVU420},
+  {GST_VIDEO_FORMAT_YV12, V4L2_PIX_FMT_YVU420M},
   {GST_VIDEO_FORMAT_YUY2, V4L2_PIX_FMT_YUYV},
   {GST_VIDEO_FORMAT_UYVY, V4L2_PIX_FMT_UYVY},
 };
@@ -631,6 +633,46 @@ sink_fmt_to_video_info (struct v4l2_format *fmt, GstVideoInfo * in_info,
   return TRUE;
 }
 
+/* VIDIOC_S_FMT on the OUTPUT queue. @fmt is in the multi-planar layout,
+ * which the rest of the helper uses for both queue types: for a single-planar
+ * driver it is converted to and from struct v4l2_pix_format, as one plane. */
+static gboolean
+gst_v4l2_encoder_s_sink_fmt (GstV4l2Encoder * self, struct v4l2_format *fmt)
+{
+  struct v4l2_pix_format_mplane *mp = &fmt->fmt.pix_mp;
+  struct v4l2_format sp = {.type = self->sink_buf_type, };
+
+  if (self->mplane)
+    return ioctl (self->video_fd, VIDIOC_S_FMT, fmt) == 0;
+
+  sp.fmt.pix.pixelformat = mp->pixelformat;
+  sp.fmt.pix.width = mp->width;
+  sp.fmt.pix.height = mp->height;
+  sp.fmt.pix.field = mp->field;
+  sp.fmt.pix.colorspace = mp->colorspace;
+  sp.fmt.pix.ycbcr_enc = mp->ycbcr_enc;
+  sp.fmt.pix.quantization = mp->quantization;
+  sp.fmt.pix.xfer_func = mp->xfer_func;
+
+  if (ioctl (self->video_fd, VIDIOC_S_FMT, &sp) < 0)
+    return FALSE;
+
+  memset (&fmt->fmt, 0, sizeof (fmt->fmt));
+  mp->pixelformat = sp.fmt.pix.pixelformat;
+  mp->width = sp.fmt.pix.width;
+  mp->height = sp.fmt.pix.height;
+  mp->field = sp.fmt.pix.field;
+  mp->colorspace = sp.fmt.pix.colorspace;
+  mp->ycbcr_enc = sp.fmt.pix.ycbcr_enc;
+  mp->quantization = sp.fmt.pix.quantization;
+  mp->xfer_func = sp.fmt.pix.xfer_func;
+  mp->num_planes = 1;
+  mp->plane_fmt[0].bytesperline = sp.fmt.pix.bytesperline;
+  mp->plane_fmt[0].sizeimage = sp.fmt.pix.sizeimage;
+
+  return TRUE;
+}
+
 gboolean
 gst_v4l2_encoder_select_sink_format (GstV4l2Encoder * self,
     GstVideoInfo * in_info, GstVideoInfoDmaDrm * vinfo_drm)
@@ -638,7 +680,7 @@ gst_v4l2_encoder_select_sink_format (GstV4l2Encoder * self,
   struct v4l2_format fmt = {.type = self->sink_buf_type, };
   guint32 pix_fmt = raw_format_to_v4l2 (self, GST_VIDEO_INFO_FORMAT (in_info));
 
-  if (!pix_fmt || !self->mplane) {
+  if (!pix_fmt) {
     GST_ERROR_OBJECT (self, "Unsupported raw format %s",
         gst_video_format_to_string (GST_VIDEO_INFO_FORMAT (in_info)));
     return FALSE;
@@ -651,7 +693,7 @@ gst_v4l2_encoder_select_sink_format (GstV4l2Encoder * self,
   fmt.fmt.pix_mp.field = V4L2_FIELD_NONE;
   colorimetry_to_v4l2 (&in_info->colorimetry, &fmt.fmt.pix_mp);
 
-  if (ioctl (self->video_fd, VIDIOC_S_FMT, &fmt) < 0) {
+  if (!gst_v4l2_encoder_s_sink_fmt (self, &fmt)) {
     GST_ERROR_OBJECT (self, "VIDIOC_S_FMT failed: %s", g_strerror (errno));
     return FALSE;
   }
@@ -822,7 +864,7 @@ gst_v4l2_encoder_get_import_memories (GstV4l2Encoder * self,
   guint i, n_planes = GST_VIDEO_INFO_N_PLANES (info);
   guint n_mems = pix->num_planes;
 
-  if (!self->mplane || n_mems < 1 || gst_buffer_n_memory (buffer) != n_mems)
+  if (n_mems < 1 || gst_buffer_n_memory (buffer) != n_mems)
     return 0;
 
   for (i = 0; i < n_mems; i++) {
@@ -898,7 +940,6 @@ gst_v4l2_encoder_queue_sink_buffer (GstV4l2Encoder * self,
     .memory = V4L2_MEMORY_DMABUF,
     .request_fd = request->fd,
     .flags = V4L2_BUF_FLAG_REQUEST_FD,
-    .m.planes = planes,
   };
   guint64 ts = GST_V4L2_ENCODER_FRAME_TS (request->frame_id);
   GstMemory *mems[GST_VIDEO_MAX_PLANES];
@@ -919,12 +960,19 @@ gst_v4l2_encoder_queue_sink_buffer (GstV4l2Encoder * self,
     return FALSE;
   }
 
-  for (i = 0; i < n; i++) {
-    planes[i].m.fd = gst_dmabuf_memory_get_fd (mems[i]);
-    planes[i].bytesused = self->sink_fmt.fmt.pix_mp.plane_fmt[i].sizeimage;
-    planes[i].length = gst_memory_get_sizes (mems[i], NULL, NULL);
+  if (self->mplane) {
+    for (i = 0; i < n; i++) {
+      planes[i].m.fd = gst_dmabuf_memory_get_fd (mems[i]);
+      planes[i].bytesused = self->sink_fmt.fmt.pix_mp.plane_fmt[i].sizeimage;
+      planes[i].length = gst_memory_get_sizes (mems[i], NULL, NULL);
+    }
+    buf.m.planes = planes;
+    buf.length = n;
+  } else {
+    buf.m.fd = fd;
+    buf.bytesused = self->sink_fmt.fmt.pix_mp.plane_fmt[0].sizeimage;
+    buf.length = gst_memory_get_sizes (mems[0], NULL, NULL);
   }
-  buf.length = n;
   buf.index = index;
   buf.timestamp.tv_sec = ts / GST_SECOND;
   buf.timestamp.tv_usec = (ts % GST_SECOND) / 1000;
