From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: =?UTF-8?q?Daniel=20Sch=C3=BCrmann?= <daniel@schuermann.dev>
Date: Tue, 20 Oct 2026 15:55:34 +0200
Subject: [PATCH] nir/lower_continue_constructs: preserve phi sources when
 simplifying loop jumps

Removing nested jumps can make paths reachable that bypass phi sources.
Lower merge phis before rewriting branches, and place their register
writes up the predecessor tree while SSA dominance still holds.

Fixes: 31af989270f ("nir/lower_continue_constructs: Simplify loops before lowering continue constructs")
Generated-by: LLM
(cherry picked from commit e775390f214f870219e60485e9c5c8620695ade3)

Part-of: <https://gitlab.freedesktop.org/mesa/mesa/-/merge_requests/45704>
(cherry picked from commit 3914ead4955c48dd684ea6ee608323bb4bf3b252)
---
 .../nir/nir_lower_continue_constructs.c       |  23 ++--
 src/compiler/nir/tests/control_flow_tests.cpp | 110 ++++++++++++++++++
 2 files changed, 122 insertions(+), 11 deletions(-)

diff --git a/src/compiler/nir/nir_lower_continue_constructs.c b/src/compiler/nir/nir_lower_continue_constructs.c
index 35f2d447ddc..c5f1155a7c0 100644
--- a/src/compiler/nir/nir_lower_continue_constructs.c
+++ b/src/compiler/nir/nir_lower_continue_constructs.c
@@ -89,6 +89,13 @@ lower_jump(nir_block *block, struct loop_simplify_state *state)
 static bool
 lower_jumps_in_if(nir_if *nif, struct loop_simplify_state *state)
 {
+   /* Lower phis before jump removal makes more predecessors reachable.
+    * Push their writes up the predecessor tree so newly reachable paths
+    * cannot bypass the definitions used by the writes.
+    */
+   nir_block *next_block = nir_cf_node_cf_tree_next(&nif->cf_node);
+   nir_lower_phis_to_regs_block(next_block, false);
+
    nir_block *then_block = nir_if_last_then_block(nif);
    nir_block *else_block = nir_if_last_else_block(nif);
    bool then_jumps = nir_block_ends_in_jump(then_block);
@@ -98,7 +105,6 @@ lower_jumps_in_if(nir_if *nif, struct loop_simplify_state *state)
    progress |= lower_jump(then_block, state);
    progress |= lower_jump(else_block, state);
 
-   nir_block *next_block = nir_cf_node_cf_tree_next(&nif->cf_node);
    bool is_empty_block = nir_cf_node_is_last(&next_block->cf_node) &&
                          exec_list_is_empty(&next_block->instr_list);
 
@@ -119,8 +125,6 @@ lower_jumps_in_if(nir_if *nif, struct loop_simplify_state *state)
        * to lower and increases control-flow depth.
        */
       assert(then_jumps || else_jumps);
-      /* Lower away potential single-src phis, if there was any. */
-      nir_lower_phis_to_regs_block(nir_cf_node_cf_tree_next(&nif->cf_node), true);
       nir_cf_list list;
       nir_cf_extract(&list, nir_after_cf_node(&nif->cf_node),
                      nir_after_cf_list(state->cf_list));
@@ -156,20 +160,17 @@ lower_jumps_in_if(nir_if *nif, struct loop_simplify_state *state)
    if (!is_empty_block && progress) {
       /* Predicate following blocks. */
       nir_cf_list list;
-      nir_cf_extract(&list, nir_after_cf_node_and_phis(&nif->cf_node),
+      nir_cf_extract(&list, nir_after_cf_node(&nif->cf_node),
                      nir_after_cf_list(state->cf_list));
 
       if (nif->cf_node.parent != &state->loop->cf_node)
          nir_cf_list_detach_ssa(&list);
 
-      /* The list might be empty if the only instructions at the merge block are phis. */
-      if (!exec_list_is_empty(&list.list)) {
-         state->b->cursor = nir_after_cf_node_and_phis(&nif->cf_node);
-         nir_if *if_stmt = nir_push_if(state->b, nir_load_reg(state->b, state->jump_flag));
+      state->b->cursor = nir_after_cf_node(&nif->cf_node);
+      nir_if *if_stmt = nir_push_if(state->b, nir_load_reg(state->b, state->jump_flag));
 
-         nir_cf_reinsert(&list, nir_before_cf_list(&if_stmt->else_list));
-         nir_pop_if(state->b, NULL);
-      }
+      nir_cf_reinsert(&list, nir_before_cf_list(&if_stmt->else_list));
+      nir_pop_if(state->b, NULL);
    }
 
    return progress;
diff --git a/src/compiler/nir/tests/control_flow_tests.cpp b/src/compiler/nir/tests/control_flow_tests.cpp
index cbc17b62904..3df2204ef1b 100644
--- a/src/compiler/nir/tests/control_flow_tests.cpp
+++ b/src/compiler/nir/tests/control_flow_tests.cpp
@@ -31,6 +31,14 @@ protected:
    }
 };
 
+class nir_lower_continue_constructs_test : public nir_test {
+protected:
+   nir_lower_continue_constructs_test()
+      : nir_test::nir_test("nir_lower_continue_constructs_test")
+   {
+   }
+};
+
 TEST_F(nir_cf_test, delete_break_in_loop)
 {
    /* Create IR:
@@ -167,3 +175,105 @@ TEST_F(nir_cf_test, lcssa_iter_safety_during_deref_remat)
    nir_validate_shader(b->shader, NULL);
    nir_validate_ssa_dominance(b->shader, NULL);
 }
+TEST_F(nir_lower_continue_constructs_test, nested_continue_unreachable_phi_predecessor)
+{
+   nir_loop *loop = nir_push_loop(b);
+   nir_loop_add_continue_construct(loop);
+   nir_push_if(b, nir_unit_test_uniform_input(b, 1, 1));
+   nir_push_if(b, nir_unit_test_uniform_input(b, 1, 1, 1));
+   nir_def *value = nir_unit_test_uniform_input(b, 1, 32, 2);
+   nir_push_else(b, NULL);
+   nir_push_if(b, nir_unit_test_uniform_input(b, 1, 1, 3));
+   nir_jump(b, nir_jump_continue);
+   nir_push_else(b, NULL);
+   nir_jump(b, nir_jump_break);
+   nir_pop_if(b, NULL);
+   nir_pop_if(b, NULL);
+   nir_push_else(b, NULL);
+   nir_def *other = nir_unit_test_uniform_input(b, 1, 32, 4);
+   nir_pop_if(b, NULL);
+   nir_use(b, nir_if_phi(b, value, other));
+   nir_break_if(b, nir_unit_test_uniform_input(b, 1, 1, 5));
+   nir_pop_loop(b, NULL);
+
+   nir_validate_shader(b->shader, "before lowering continue constructs");
+   ASSERT_TRUE(nir_lower_continue_constructs(b->shader));
+   nir_validate_shader(b->shader, "after lowering continue constructs");
+
+   check_nir_string(NIR_REFERENCE_SHADER(R"(
+      shader: MESA_SHADER_COMPUTE
+      name: nir_lower_continue_constructs_test
+      workgroup_size: 1, 1, 1
+      max_subgroup_size: 128
+      min_subgroup_size: 1
+      decl_function main () (entrypoint)
+
+      impl main {
+          block b0:   // preds:
+          32     %0 = undefined
+                      // succs: b1
+          loop {
+              block b1:   // preds: b0 b16
+              32     %1 = phi b0: %0, b16: %12
+              1      %2 = load_const (false)
+              1      %3 = @unit_test_uniform_input (base=0)
+                          // succs: b2 b9
+              if %3 {
+                  block b2:   // preds: b1
+                  1      %4 = @unit_test_uniform_input (base=1)
+                              // succs: b3 b4
+                  if %4 {
+                      block b3:   // preds: b2
+                      32     %5 = @unit_test_uniform_input (base=2)
+                                  // succs: b8
+                  } else {
+                      block b4:   // preds: b2
+                      1      %6 = @unit_test_uniform_input (base=3)
+                                  // succs: b5 b6
+                      if %6 {
+                          block b5:   // preds: b4
+                          1      %7 = load_const (true)
+                                      // succs: b7
+                      } else {
+                          block b6:// preds: b4
+                          break
+                          // succs: b17
+                      }
+                      block b7:  // preds: b5, succs: b8
+                  }
+                  block b8:   // preds: b3 b7
+                  1      %8 = phi b3: %2 (false), b7: %7 (true)
+                  32     %9 = phi b3: %5, b7: %1
+                              // succs: b10
+              } else {
+                  block b9:   // preds: b1
+                  32    %10 = @unit_test_uniform_input (base=4)
+                              // succs: b10
+              }
+              block b10:  // preds: b8 b9
+              1     %11 = phi b8: %8, b9: %2 (false)
+              32    %12 = phi b8: %9, b9: %10
+                          // succs: b11 b12
+              if %11 {
+                  block b11:  // preds: b10, succs: b16
+              } else {
+                  block b12:  // preds: b10
+                              @use (%12)
+                  1     %13 = @unit_test_uniform_input (base=5)
+                              // succs: b13 b14
+                  if %13 {
+                      block b13:// preds: b12
+                      break
+                      // succs: b17
+                  } else {
+                      block b14:  // preds: b12, succs: b15
+                  }
+                  block b15:  // preds: b14, succs: b16
+              }
+              block b16:  // preds: b11 b15, succs: b1
+          }
+          block b17:  // preds: b6 b13, succs: b18
+          block b18:
+      }
+   )"));
+}
