From 33b3caa342dc2f7aac27f4fa3bcd0126ae01ab9b Mon Sep 17 00:00:00 2001
From: Arun Iyengar <aiyengar1990@gmail.com>
Date: Thu, 5 Nov 2026 14:14:37 +0000
Subject: [PATCH] v4l2-compliance: do not let AFBC capture formats hide a
 stateless decoder

cedrus lists the AFBC 16x16 split formats (AS12, AS01) on its CAPTURE
queue. They carry V4L2_FMT_FLAG_COMPRESSED, so is_codec_format() took
them for codec formats, determine_codec_mask() hit its default case and
returned with no codec mask, and the DECODER_CMD test then ran with
stateful rules (v4l2-test-codecs.cpp(161) fail).

AFBC is compressed raw image data, like QC08C/QC10C: exclude it in
is_codec_format(). cedrus also takes JPEG on OUTPUT next to its
stateless formats; keep such a node a stateless decoder.

Assisted-by: LLM
Signed-off-by: Arun Iyengar <aiyengar1990@gmail.com>
---
 utils/common/v4l2-info.cpp                | 10 ++++++++++
 utils/v4l2-compliance/v4l2-compliance.cpp |  7 +++++++
 2 files changed, 17 insertions(+)

diff --git a/utils/common/v4l2-info.cpp b/utils/common/v4l2-info.cpp
index c9ad1ba..9d5426d 100644
--- a/utils/common/v4l2-info.cpp
+++ b/utils/common/v4l2-info.cpp
@@ -893,6 +893,14 @@ std::string subdevclientcap2s(__u64 cap)
 	return s;
 }
 
+/* AFBC compressed raw formats used by sunxi cedrus/DE33. */
+#ifndef V4L2_PIX_FMT_YUV420_8_AFBC_16X16_SPLIT
+#define V4L2_PIX_FMT_YUV420_8_AFBC_16X16_SPLIT	v4l2_fourcc('A', 'S', '1', '2')
+#endif
+#ifndef V4L2_PIX_FMT_YUV420_10_AFBC_16X16_SPLIT
+#define V4L2_PIX_FMT_YUV420_10_AFBC_16X16_SPLIT	v4l2_fourcc('A', 'S', '0', '1')
+#endif
+
 bool is_codec_format(const v4l2_fmtdesc& fmt_desc) {
     if (!(fmt_desc.flags & V4L2_FMT_FLAG_COMPRESSED))
         return false;
@@ -900,6 +908,8 @@ bool is_codec_format(const v4l2_fmtdesc& fmt_desc) {
     switch (fmt_desc.pixelformat) {
         case V4L2_PIX_FMT_QC08C:
         case V4L2_PIX_FMT_QC10C:
+        case V4L2_PIX_FMT_YUV420_8_AFBC_16X16_SPLIT:
+        case V4L2_PIX_FMT_YUV420_10_AFBC_16X16_SPLIT:
             return false;
         default:
             return true;
diff --git a/utils/v4l2-compliance/v4l2-compliance.cpp b/utils/v4l2-compliance/v4l2-compliance.cpp
index b6fcc5c..78dcc76 100644
--- a/utils/v4l2-compliance/v4l2-compliance.cpp
+++ b/utils/v4l2-compliance/v4l2-compliance.cpp
@@ -634,6 +634,13 @@ static void determine_codec_mask(struct node &node)
 		num_out_fmts++;
 	} while (!node.enum_fmt(fmt_desc));
 
+	/*
+	 * A stateless decoder may also take JPEG on its OUTPUT queue
+	 * (cedrus does). The node is still a stateless decoder.
+	 */
+	if (mask & STATELESS_DECODER)
+		mask &= ~JPEG_DECODER;
+
 	if (num_compressed_out_fmts == 0 && num_compressed_cap_fmts == num_cap_fmts)
 		node.codec_mask = mask;
 	else if (num_compressed_cap_fmts == 0 && num_compressed_out_fmts == num_out_fmts)
-- 
